# Copy to .env.local for local development.
# These browser-safe values come from Supabase Project Settings > API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional explicit-action geocoder fallback. Do not use a public Nominatim URL
# for autocomplete; seeded route locations power all as-you-type suggestions.
# VITE_GEOCODER_URL=https://your-approved-geocoder.example/search

# Never put a Supabase service-role key or payment secret in VITE_* variables.

# Phase 3 Edge Function settings are configured with `supabase secrets set`, not in this file:
# PAYMENT_PROVIDER=mock
# ALLOW_MOCK_PAYMENTS=false  # true only in a disposable test project
# PUBLIC_APP_URL=https://your-preview-or-site.example
# MOCK_WEBHOOK_SECRET=long-random-server-secret
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
